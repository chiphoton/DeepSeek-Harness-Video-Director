{
  "description": "MiniMax-H3 Turbo video workflow with text-to-video, locked first or last frame, and first-to-last frame modes, plus configurable duration and resolution.",
  "provenance": {
    "source": "User-supplied i2v-turbo.json ComfyUI editor workflow",
    "referenceIntegration": "https://github.com/chiphoton/MiniMax-H3-Codex-Drama",
    "turboNodes": "https://github.com/Larryvrh/ComfyUI-MiniMax-H3-Turbo/tree/4274783a23afcfdbea3b4876cb79effd6c510785"
  },
  "nodeData": {
    "kind": "video-generation",
    "title": "MiniMax-H3 Text/Image to Video (Turbo)",
    "providerId": "comfyui",
    "modelFamily": "minimax-h3",
    "prompt": "",
    "videoMode": "text-to-video",
    "duration": 5,
    "fps": 24,
    "seed": 1001,
    "seedControlAfterGenerate": "randomize",
    "variant": "turbo",
    "steps": 4,
    "scheduler": "simple",
    "workflow": {
      "119": {
        "class_type": "VAELoader",
        "inputs": { "vae_name": "minimax_h3_video_vae_fp16.safetensors" }
      },
      "120": {
        "class_type": "VAELoader",
        "inputs": { "vae_name": "minimax_h3_audio_vae_fp32.safetensors" }
      },
      "121": {
        "class_type": "VAEDecodeAudio",
        "inputs": { "samples": ["125", 0], "vae": ["120", 0] }
      },
      "122": {
        "class_type": "VAEDecode",
        "inputs": { "samples": ["125", 0], "vae": ["119", 0] }
      },
      "124": {
        "class_type": "BasicScheduler",
        "inputs": { "model": ["134", 0], "scheduler": "simple", "steps": 4, "denoise": 1 }
      },
      "125": {
        "class_type": "SamplerCustomAdvanced",
        "inputs": {
          "noise": ["129", 0],
          "guider": ["126", 0],
          "sampler": ["135", 0],
          "sigmas": ["124", 0],
          "latent_image": ["131", 1]
        }
      },
      "126": {
        "class_type": "BasicGuider",
        "inputs": { "model": ["134", 0], "conditioning": ["131", 0] }
      },
      "127": {
        "class_type": "UNETLoader",
        "inputs": { "unet_name": "minimax_h3_fl2va_int8_convrot.safetensors", "weight_dtype": "default" }
      },
      "128": {
        "class_type": "CLIPLoader",
        "inputs": {
          "clip_name": "qwen3vl_32b_minimax_h3_int8_convrot.safetensors",
          "type": "minimax",
          "device": "default"
        }
      },
      "129": {
        "class_type": "RandomNoise",
        "inputs": { "noise_seed": 1001 }
      },
      "130": {
        "class_type": "CreateVideo",
        "inputs": { "images": ["122", 0], "fps": 24, "audio": ["121", 0], "bit_depth": 8 }
      },
      "131": {
        "class_type": "MiniMaxH3ImageToVideo",
        "inputs": {
          "clip": ["128", 0],
          "vae": ["119", 0],
          "prompt": "<prompt_here>",
          "first_frame": ["136", 0],
          "last_frame": ["139", 0],
          "width": ["115", 0],
          "height": ["115", 1],
          "length": ["132", 1]
        }
      },
      "132": {
        "class_type": "ComfyMathExpression",
        "inputs": {
          "expression": "max(5, round(a * 24)) + (5 - (max(5, round(a * 24)) % 17)) % 17",
          "values.a": ["133", 0]
        }
      },
      "133": {
        "class_type": "PrimitiveFloat",
        "inputs": { "value": 5 }
      },
      "134": {
        "class_type": "MiniMaxH3TurboLoRA",
        "inputs": {
          "model": ["127", 0],
          "lora_name": "minimax_h3_turbo_v4_step600_ema.safetensors",
          "strength": 1,
          "low_vram": false
        }
      },
      "135": {
        "class_type": "MiniMaxH3TurboSampler",
        "inputs": {}
      },
      "136": {
        "class_type": "LoadImage",
        "inputs": { "image": "<first_frame>" }
      },
      "139": {
        "class_type": "LoadImage",
        "inputs": { "image": "<last_frame>" }
      },
      "115": {
        "class_type": "ResolutionSelector",
        "inputs": { "aspect_ratio": "3:4 (Portrait Standard)", "megapixels": 0.7, "multiple": 32 }
      },
      "92": {
        "class_type": "SaveVideo",
        "inputs": { "video": ["130", 0], "filename_prefix": "video-turbo", "format": "auto", "codec": "auto" }
      }
    },
    "bindings": [
      {
        "nodeId": "136",
        "input": "image",
        "from": "asset",
        "portId": "reference",
        "portIndex": 0,
        "optional": true,
        "omitNodeWhenMissing": true,
        "frameRole": "first"
      },
      {
        "nodeId": "139",
        "input": "image",
        "from": "asset",
        "portId": "reference",
        "portIndex": 1,
        "optional": true,
        "omitNodeWhenMissing": true,
        "frameRole": "last"
      },
      { "nodeId": "131", "input": "prompt", "from": "prompt" },
      { "nodeId": "133", "input": "value", "from": "duration" },
      { "nodeId": "129", "input": "noise_seed", "from": "seed" },
      { "nodeId": "124", "input": "steps", "from": "steps" }
    ],
    "parameters": [
      {
        "id": "aspectRatio",
        "nodeId": "115",
        "input": "aspect_ratio",
        "label": "Aspect ratio",
        "group": "Resolution Selector",
        "type": "text",
        "default": "3:4 (Portrait Standard)",
        "placement": "primary",
        "control": "select",
        "choices": [
          "1:1 (Square)",
          "2:3 (Portrait Photo)",
          "3:2 (Photo)",
          "3:4 (Portrait Standard)",
          "4:3 (Standard)",
          "9:16 (Portrait Widescreen)",
          "16:9 (Widescreen)",
          "21:9 (Ultrawide)"
        ],
        "description": "ResolutionSelector aspect ratio.",
        "order": 0
      },
      {
        "id": "megapixels",
        "nodeId": "115",
        "input": "megapixels",
        "label": "MegaPixels",
        "group": "Resolution Selector",
        "type": "number",
        "default": 0.7,
        "placement": "primary",
        "control": "input",
        "description": "Target megapixels. Click the label in the node to inspect the source workflow's size reference table.",
        "order": 1
      },
      {
        "id": "diffusionModel",
        "nodeId": "127",
        "input": "unet_name",
        "label": "Diffusion model",
        "group": "Models",
        "type": "text",
        "default": "minimax_h3_fl2va_int8_convrot.safetensors",
        "placement": "advanced",
        "control": "input",
        "description": "UNETLoader model. Available choices are discovered from ComfyUI.",
        "order": 2
      },
      {
        "id": "clipModel",
        "nodeId": "128",
        "input": "clip_name",
        "label": "CLIP",
        "group": "Models",
        "type": "text",
        "default": "qwen3vl_32b_minimax_h3_int8_convrot.safetensors",
        "placement": "advanced",
        "control": "input",
        "description": "CLIPLoader model. Available choices are discovered from ComfyUI.",
        "order": 3
      },
      {
        "id": "loraModel",
        "nodeId": "134",
        "input": "lora_name",
        "label": "LoRA",
        "group": "LoRA",
        "type": "text",
        "default": "minimax_h3_turbo_v4_step600_ema.safetensors",
        "placement": "advanced",
        "control": "input",
        "description": "MiniMaxH3TurboLoRA model. Available choices are discovered from ComfyUI.",
        "order": 4
      },
      {
