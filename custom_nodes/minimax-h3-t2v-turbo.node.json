        "type": "number",
        "default": 1,
        "placement": "advanced",
        "control": "input",
        "description": "MiniMaxH3TurboLoRA strength.",
        "order": 5
      },
      {
        "id": "videoVae",
        "nodeId": "119",
        "input": "vae_name",
        "label": "Video VAE",
        "group": "Models",
        "type": "text",
        "default": "minimax_h3_video_vae_fp16.safetensors",
        "placement": "advanced",
        "control": "input",
        "description": "Video VAELoader model. Available choices are discovered from ComfyUI.",
        "order": 6
      },
      {
        "id": "audioVae",
        "nodeId": "120",
        "input": "vae_name",
        "label": "Audio VAE",
        "group": "Models",
        "type": "text",
        "default": "minimax_h3_audio_vae_fp32.safetensors",
        "placement": "advanced",
        "control": "input",
        "description": "Audio VAELoader model. Available choices are discovered from ComfyUI.",
        "order": 7
      }
    ]
  }
}
