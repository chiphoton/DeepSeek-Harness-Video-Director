{
  "name": "dsh-video-director",
  "version": "0.1.2",
  "description": "A project-scoped multimodal video director plugin for DeepSeek Harness.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/**/*.js",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "custom_nodes/",
    "docs/",
    "examples/",
    "schemas/",
    "skills/",
    "README.md",
    "README_zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "check": "npm run build && npm run typecheck && npm run test",
    "prepack": "npm run build"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "video",
    "comfyui",
    "minimax-h3",
    "infinite-canvas"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.1.2-alpha.3",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@openai/codex-sdk": "^0.152.1",
    "@xyflow/react": "12.11.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "esbuild": "0.28.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^6.0.3"
  }
}
